# Application
APP_NAME=WorkforceMonitoring
APP_VERSION=1.0.0
DEBUG=True
ENVIRONMENT=development

# Server
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/workforce_monitoring
DATABASE_ECHO=False

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=your-secret-key-here-change-in-production
JWT_SECRET_KEY=your-jwt-secret-key-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
SHARE_LINK_EXPIRE_HOURS=8

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# File Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=5
PHOTO_RETENTION_DAYS=30
LOCATION_RETENTION_DAYS=90

# Face Detection
FACE_DETECTION_MODEL=mediapipe
FACE_CONFIDENCE_THRESHOLD=0.6
LIVENESS_THRESHOLD=0.7

# Geofencing
DEFAULT_GEOFENCE_RADIUS_METERS=500
LOCATION_ACCURACY_THRESHOLD_METERS=50

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100
LOGIN_RATE_LIMIT_PER_15MIN=5
CHECKIN_RATE_LIMIT_PER_HOUR=10

# Email (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@workforce-monitoring.com

# Monitoring
SENTRY_DSN=
LOG_LEVEL=INFO

# AWS (Optional - for production)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=workforce-monitoring-photos
